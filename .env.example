# Opcional: Vienna incluye el identificador público de su formulario de sugerencias.
# Copia este archivo a .env.local para sustituirlo por otro identificador público.
# Dejar el valor vacío desactiva el envío directo y permite preparar un correo.
# No uses aquí secretos de cuenta: VITE_* se incluye en el código del cliente.
VITE_WEB3FORMS_ACCESS_KEY=
